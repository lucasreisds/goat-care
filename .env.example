# Copy to .env (never commit .env). Required from stage 5 (login, Firestore).
# These web keys are not secrets (they ship in the app); access is protected by firestore.rules.
# Find these in Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Stage 6 (push notifications): Firebase Console > Project settings > Cloud Messaging > Web Push certificates > Generate key pair.
VITE_FIREBASE_VAPID_KEY=
